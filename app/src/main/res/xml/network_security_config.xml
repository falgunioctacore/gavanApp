<?xml version="1.0" encoding="utf-8"?>
<!--
  The release rules: every connection must be https, and only the system's trusted certificate authorities count —
  no plain http, no user-installed certificates (which is what a network-sniffing proxy would need).
  The debug build replaces this file (app/src/debug/res/xml) to allow the local development server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
